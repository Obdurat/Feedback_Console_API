generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id String @id @default(uuid())

  name String @unique

  employees TeamMember[]

  createdAt DateTime @default(now())
}

model TeamMember {
  id String @id @default(uuid())
  
  firstLogin   Boolean @default(true)

  name String

  employeeCode  String @unique

  status String

  hiringDate DateTime

  wave Int

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  reportsToId String?
  reportsTo   TeamMember? @relation("Hierarchy", fields: [reportsToId], references: [id])

  subordinates TeamMember[] @relation("Hierarchy")

  receivedFeedbacks Feedback[] @relation("FeedbackReceiver")

  submittedFeedbacks Feedback[] @relation("FeedbackSubmitter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  totpSecret  String?
  totpEnabled Boolean @default(false)
}

model Feedback {
  id String @id @default(uuid())

  type FeedbackType

  category String

  comment String

  createdAt DateTime @default(now())

  memberId String
  member   TeamMember @relation("FeedbackReceiver", fields: [memberId], references: [id])

  submittedById String
  submittedBy   TeamMember @relation("FeedbackSubmitter", fields: [submittedById], references: [id])

  viewed Boolean @default(false)
  viewedAt DateTime?

  acknowledgedAt DateTime?
}

enum FeedbackType {
  POSITIVE
  IMPROVEMENT
}
